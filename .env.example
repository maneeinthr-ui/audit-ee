# ─── Anthropic API Key (สำหรับ AI วิเคราะห์รูปภาพ) ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── LINE Messaging API (สำหรับแจ้งเตือนช่าง — ฟรี 200 msg/เดือน) ───────────
# 1. ไปที่ developers.line.biz → Create Provider → Create Messaging API Channel
# 2. Messaging API tab → Issue Channel Access Token (Long-lived)
LINE_CHANNEL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 3. เพิ่มบอทเข้ากลุ่ม LINE ของช่าง → ส่งข้อความใดๆ ในกลุ่ม
#    → ดู Group ID ได้ที่ Settings > LINE ในแอป (webhook จะจับ ID ให้อัตโนมัติ)
LINE_TARGET_ID=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Google Sheets CSV URL (Master Data ป้ายทั้งหมด) ─────────────────────────
# วิธีได้ URL: Google Sheets → File → Share → Anyone with link (Viewer)
# แล้วใช้ URL นี้: https://docs.google.com/spreadsheets/d/{SHEET_ID}/export?format=csv&gid={GID}
GOOGLE_SHEETS_URL=

# ─── Server Port ─────────────────────────────────────────────────────────────
PORT=3000
